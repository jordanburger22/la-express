// This file replaces the CREATE TABLE you wrote by hand.
//
// Describe the table here, run `npx prisma db push`, and Prisma makes the database match.
// Change something, run it again.
//
// There is no url in here. From Prisma 7 the connection string lives in prisma.config.js instead,
// so this file is only ever about the shape of your data. If you find an older tutorial with
// `url = env("DATABASE_URL")` in this block, that is why it does not work.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Same columns as the games table we made with SQL:
//   id SERIAL PRIMARY KEY, title TEXT, genre TEXT, developer TEXT, rating INTEGER, completed BOOLEAN
model Game {
  id        Int      @id @default(autoincrement())
  title     String
  genre     String?
  developer String?
  rating    Int?
  completed Boolean  @default(false)
}
